# Copy to .env.local.
# --- LLM (optional: without a key the app runs in demo/mock mode)
OPENROUTER_API_KEY=
# Check exact slugs at https://openrouter.ai/models
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_MODEL_STRONG=anthropic/claude-sonnet-4.5

# --- Neo4j persistence (optional: without NEO4J_URI the app falls back to the CSV extract)
# Local: `docker compose up neo4j`  ·  Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tpcopilot-dev
# NEO4J_DATABASE=neo4j
